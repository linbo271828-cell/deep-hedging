# ── Backend environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in values for local overrides.
# In production (Railway), set these in the Railway service dashboard.

# Comma-separated list of allowed CORS origins.
# Local dev default: http://localhost:3000
# Production: add your Vercel frontend URL, e.g.
#   ALLOWED_ORIGINS=https://deep-hedging-lab.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Port to bind (set automatically by Railway — leave unset for local dev).
# PORT=8000
